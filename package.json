{
  "name": "@devicai/cli",
  "version": "0.24.0",
  "description": "CLI for the Devic AI Platform API",
  "type": "module",
  "bin": {
    "devic": "./bin/devic.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "./bin/devic.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:tty": "npm run build && python3 tests/live-tty.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devicai/devic-cli.git"
  },
  "homepage": "https://github.com/devicai/devic-cli",
  "bugs": {
    "url": "https://github.com/devicai/devic-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "devic",
    "ai",
    "cli",
    "agents",
    "assistants",
    "llm",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "marked": "^18.0.13",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@xterm/headless": "^5.5.0",
    "typescript": "^5.7.0"
  }
}
